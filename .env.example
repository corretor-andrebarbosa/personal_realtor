# Google Ads / tracking
# Landing pages estáticas (public/apto-parque-parahyba-1) leem estes valores em
# /api/ads-config. Cadastre-os no Cloudflare Pages > Settings > Environment variables.
GOOGLE_ADS_ID=AW-XXXXXXXXX
ADS_CONVERSION_WHATSAPP=AW-XXXXXXXXX/label_whatsapp
ADS_CONVERSION_FORM=AW-XXXXXXXXX/label_formulario
ADS_CONVERSION_PHONE=AW-XXXXXXXXX/label_ligacao
# As mesmas chaves com prefixo VITE_ servem ao app React e também são aceitas pela função:
VITE_GOOGLE_ADS_ID=AW-XXXXXXXXX
VITE_ADS_CONVERSION_WHATSAPP=AW-XXXXXXXXX/label_whatsapp
VITE_ADS_CONVERSION_FORM=AW-XXXXXXXXX/label_formulario
VITE_ADS_CONVERSION_PHONE=AW-XXXXXXXXX/label_ligacao

# Site / contato
VITE_PUBLIC_WHATSAPP=5583996828008
VITE_PUBLIC_TELEGRAM=corretorandrebarbosa

# Supabase (já usado pelo projeto)
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SEU_ANON_KEY
